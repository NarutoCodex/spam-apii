syntax = "proto3";

message MajorLogin {
  // Field numbers directly from the captured data
  string event_time = 3;                          // "2026-07-07 23:00:18"
  string game_name = 4;                          // "free fire"
  int32 platform_id = 5;                        // 1
  string client_version = 7;                    // "1.126.9"
  string system_software = 8;                   // "Android OS 13 / API-33 ..."
  string device_type = 9;                       // "Handheld"
  string telecom_operator = 10;                 // "Vi India"
  string network_type = 11;                     // "CarrierDataNetwork"
  int32 screen_width = 12;                      // 1650
  int32 screen_height = 13;                     // 720
  string screen_dpi = 14;                       // "320"
  string processor_details = 15;                // "ARM64 FP ASIMD AES | 4800 | 8"
  int32 memory = 16;                            // 5652
  string gpu_renderer = 17;                     // "Adreno (TM) 610"
  string gpu_version = 18;                      // "OpenGL ES 3.2 V@0502.41 ..."
  string unique_device_id = 19;                 // "Google|c6c902a0-..."
  string client_ip = 20;                        // "42.111.9.117"
  string language = 21;                         // "en"
  string others = 22;                           // "e29d26f9f8fe17ae12615686e5c83e17"
  string open_id_type = 23;                     // "8"
  string system_hardware = 24;                  // "Handheld"
  string device_model = 25;                     // "Xiaomi 220333QBI"
  string region = 26;                           // "TW"
  string signature_md5 = 29;                    // "4fbc8cb712201ffb6d02b41a0631c094..."
  int32 if_push = 30;                           // 1
  string network_operator_a = 41;               // "Vi India"
  string network_type_a = 42;                   // "4G"
  string client_using_version = 57;             // "7428b253defc164018c604a1ebbfebdf"
  int32 sdcard_total_storage = 60;              // 104713
  int32 sdcard_avail_storage = 61;              // 45810
  int32 inner_total_storage = 62;               // 1309
  int32 inner_avail_storage = 64;               // 45938
  int32 game_installed_disk_total_storage = 65; // 104713
  int32 game_installed_disk_avail_storage = 66; // 45938
  int32 external_sdcard_total_storage = 67;     // 104713
  int32 reg_avatar = 73;                        // 1
  string library_path = 74;                     // "/data/app/~~pFI9sn.../lib/arm64"
  int32 field_76 = 76;                          // 1
  string library_token = 77;                    // "4c322aeb...|/data/app/.../base.apk"
  uint32 channel_type = 78;                     // 3
  uint32 cpu_type = 79;                         // 2
  string cpu_architecture = 81;                 // "64"
  string client_version_code = 83;              // "2019120776"
  string graphics_api = 86;                     // "OpenGLES2"
  uint32 supported_astc_bitset = 87;            // 4095
  int32 field_88 = 88;                          // 8
  string city = 90;                             // "Delhi"
  string state = 91;                            // "DL"
  uint32 loading_time = 92;                     // 7152
  string release_channel = 93;                  // "android"
  bytes analytics_detail = 94;                  // base64 string (decoded to bytes)
  int32 field_95 = 95;                          // 111207
  string extra_info = 96;                       // "{\"cur_rate\":null,\"support_etc2\":false}"
  int32 field_97 = 97;                          // 1
  string field_99 = 99;                         // "0"
  string field_100 = 100;                       // "8"
  string field_102 = 102;                       // "105d421554080c5531"
  int32 field_103 = 103;                        // 1
}